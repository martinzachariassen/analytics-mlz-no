# Only apps/server and infra/docker are copied into the image; keep the rest out of the build
# context so a build never ships a database, a secret or a node_modules tree.
.git
.github
.githooks
.claude
docs
data
bin
scripts
**/node_modules
**/dist
**/.firebase
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.mmdb
**/*.log
infra/terraform
apps/web
apps/tracker
apps/demo
