# Copy to terraform.tfvars (git-ignored) and adjust.
project_id           = "analytics-mlz-no"
domain               = "analytics.mlz.no"
extra_domains        = ["t.mlz.no"] # optional alias, e.g. a short host for the tracking script
github_client_id     = "Ov23li..."
allowed_github_users = ["martinzachariassen"]
retention_days       = 0
# github_repository  = "you/analytics"     # deploy from GitHub Actions on merge to main (Workload Identity Federation)
# alert_email        = "you@example.com"   # alerts (abuse, backups, replication, downtime); empty = off
# require_replica    = true                # set after the first deploy: refuse to start from an empty replica
# replica_path       = "analytics"         # Litestream path in <project>-db; change only to restore (runbook)
# ingest_rate_limit  = 50                  # events/s across all clients
# max_database_mb    = 200                 # pause ingestion above this (disk is in memory on Cloud Run)
# backup_hourly_retention_days = 3         # hourly standalone backups (gs://<project>-backups/hourly/)
# backup_daily_retention_days  = 90        # daily standalone backups (gs://<project>-backups/daily/)
