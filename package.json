{
  "name": "analytics-mlz-no",
  "private": true,
  "description": "Lightweight, privacy-friendly, self-hostable web analytics: a Go server, a tracking script and a React dashboard.",
  "homepage": "https://github.com/martinzachariassen/analytics-mlz-no",
  "author": "Martin Zachariassen <hi@mlz.no>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinzachariassen/analytics-mlz-no.git"
  },
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/tracker"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "biome ci . && test -z \"$(gofmt -l apps/server)\"",
    "format": "biome check --write . && gofmt -w apps/server",
    "test": "./scripts/verify.sh go tracker web",
    "verify": "./scripts/verify.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "firebase-tools": "^15.34.2"
  }
}
