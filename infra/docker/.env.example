# Copy to infra/docker/.env (git-ignored). Every variable is documented in docs/reference/configuration.md.

# Number of reverse proxies in front of the server (0 = direct, 1 = behind nginx/Caddy/Traefik).
PROXY_HOPS=0

# Where users open the dashboard. Must be https:// when sign-in is enabled (localhost excepted).
PUBLIC_URL=http://localhost:8080

# Dashboard sign-in via a GitHub OAuth App (callback: <PUBLIC_URL>/api/auth/github/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_USERS=

# Delete events older than N days (0 = keep forever).
RETENTION_DAYS=0

# Optional off-site backup with Litestream, e.g. s3://bucket/analytics or gs://bucket/analytics.
# S3 needs LITESTREAM_ACCESS_KEY_ID and LITESTREAM_SECRET_ACCESS_KEY (or AWS_* variables);
# GCS needs GOOGLE_APPLICATION_CREDENTIALS pointing at a mounted service-account key.
# Set REQUIRE_REPLICA=1 once the replica holds data, so a lost replica stops the server
# instead of starting it empty.
#LITESTREAM_REPLICA_URL=
#REQUIRE_REPLICA=0
