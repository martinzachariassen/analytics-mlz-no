# Only apps/server, apps/web (built in its own stage), the workspace manifests and infra/docker
# are used by the build; keep the rest out of the build context so a build never ships a
# database, a secret or a node_modules tree.
.git
.github
.githooks
.claude
docs
data
bin
scripts
**/node_modules
**/dist
**/.firebase
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.mmdb
**/*.log
infra/terraform
apps/web/e2e/.auth
apps/web/test-results
apps/web/playwright-report
# The workspace lockfile lists the tracker, so its manifest is needed; nothing else of it.
apps/tracker/*
!apps/tracker/package.json
# A local `make embed-web` copy; the image embeds its own fresh build.
apps/server/internal/web/static/*
gha-creds-*.json
