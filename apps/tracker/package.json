{
  "name": "@analytics-mlz-no/tracker",
  "private": true,
  "type": "module",
  "description": "Tiny, cookie-free tracking script for analytics-mlz-no",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=iife --target=es2022 --define:MLZ_TEST=false --legal-comments=none --outfile=../server/internal/script/script.js",
    "size": "npm run build && gzip -c ../server/internal/script/script.js | wc -c",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
